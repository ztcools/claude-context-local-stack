# =============================================================================
# claude-context 一体化部署配置模板
# 用法: cp .env.example .env  然后按实际情况修改。
# 注意: .env 含密钥,已被 .gitignore 忽略,请勿提交。
# =============================================================================

# ---- 通用 -------------------------------------------------------------------
# 容器名 / 网络名前缀
PROJECT_PREFIX=claude
# Milvus 数据持久化根目录(下含 etcd / minio / milvus)。默认在部署目录下 ./data;
# 若要复用已有 Milvus 数据,指向其 volumes 目录的绝对路径即可。
DATA_DIR=./data

# ---- MinIO(Milvus 对象存储)------------------------------------------------
# 复用现有 milvus 数据时,凭据必须与原部署一致(原为 minioadmin/minioadmin)。
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Milvus -----------------------------------------------------------------
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091

# ---- Ollama(向量化推理)----------------------------------------------------
OLLAMA_PORT=11435
# Ollama 模型数据目录。默认 ./data/ollama;复用已有模型时指向其数据目录的绝对路径。
OLLAMA_DATA=./data/ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSION=768
# ---- Ollama 资源调优(按服务器配置伸缩;以下为 4×RTX3090/96C/376G 实测值)----
# GPU 卡数: all 或具体数字。低配机(单卡/CPU)改 OLLAMA_GPU_COUNT=1 并删 compose 的 deploy 段。
OLLAMA_GPU_COUNT=all
OLLAMA_NUM_GPUS=4
# 并发: 单模型并行请求数 × 调度并行。显存充足(RTX3090 24G)可上调;显存吃紧下调。
OLLAMA_NUM_PARALLEL=8
OLLAMA_PARALLEL_REQUESTS=32
OLLAMA_MAX_BATCH_SIZE=1024
# embedding 是 CPU 轻活,16 线程足够;核数少可降到 8。
OLLAMA_CPU_THREADS=16

# ---- git-index(定时索引服务)----------------------------------------------
# 管理 API + 前端“GitLab 仓库管理”页使用的宿主端口(浏览器直连)。
GIT_INDEX_PORT=8795
# git-index 工作目录(仓库克隆 + 配置文件持久化)。
GIT_INDEX_DATA=./data/git-index
# 每日定时拉取的小时(0-23),也可在网页里改。
GIT_INDEX_DAILY_HOUR=3
# 同时索引几个仓库(同一仓库的多个分支始终串行,它们共用一份 checkout)。
# 瓶颈是 Ollama 向量化: 建议不超过 OLLAMA_NUM_PARALLEL,再大只是排队。
GIT_INDEX_CONCURRENCY=3
# 每个 collection 索引完立刻从 Milvus 内存里 release。上千 collection 规模下这是
# 防 OOM 的关键开关,搜索侧遇到未加载会自动重载。仅调试时改 false。
GIT_INDEX_RELEASE_AFTER=true
# 内网 GitLab 若为自签证书,设为 true 跳过 TLS 校验。
GIT_SSL_NO_VERIFY=false
# 以该 uid:gid 运行 git-index,避免克隆产物出现 root 属主文件(服务器上为 1015:1015)。
GIT_INDEX_UID=1015
GIT_INDEX_GID=1015

# ---- PhiGent(Web 控制台)---------------------------------------------------
PHIGENT_PORT=18000
# phigent 服务端连接 Milvus(同 compose 网络用容器名)。
MILVUS_URL=standalone:19530

# ---- 容器资源上限(共享服务器: 故障半径控制)---------------------------------
# 这台机器和其他团队共用。上限的意义是"我们失控时自己 OOM 重启",而不是把整机
# 拖垮。默认合计约 126 GiB / 60 核,给别人留出三分之二。独占机器可整体上调。
# Milvus 是最大消耗方;配合 assets/milvus-user.yaml 的 mmap 后实际远低于上限。
MILVUS_MEM_LIMIT=64g
MILVUS_CPU_LIMIT=24
OLLAMA_MEM_LIMIT=32g
OLLAMA_CPU_LIMIT=16
# 大致按每个索引 worker 4~5 GiB 估;调大 GIT_INDEX_CONCURRENCY 时同步上调。
GIT_INDEX_MEM_LIMIT=16g
GIT_INDEX_CPU_LIMIT=12
MINIO_MEM_LIMIT=8g
MINIO_CPU_LIMIT=4
ETCD_MEM_LIMIT=4g
ETCD_CPU_LIMIT=2
PHIGENT_MEM_LIMIT=2g
PHIGENT_CPU_LIMIT=2
