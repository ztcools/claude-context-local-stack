# =============================================================================
# claude-context 部署配置模板
# 用法: cp .env.example .env  编辑后运行 ./deploy.sh
# =============================================================================

# ---- 必填：MinIO 凭据（Milvus 对象存储）----------------------------------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---- 容器名前缀 -----------------------------------------------------------
PROJECT_PREFIX=claude

# ---- 数据持久化目录 -------------------------------------------------------
DATA_DIR=./data                     # Milvus 数据根目录（etcd + minio + milvus）
OLLAMA_DATA=./data/ollama           # Ollama 模型存储
GIT_INDEX_DATA=./data/git-index     # git-index 工作目录（仓库克隆 + 配置）

# ---- 服务端口 -------------------------------------------------------------
MILVUS_PORT=19530                   # Milvus gRPC
MILVUS_METRICS_PORT=9091            # Milvus metrics
OLLAMA_PORT=11435                   # Ollama API
GIT_INDEX_PORT=8795                 # git-index HTTP 管理口
PHIGENT_PORT=18000                  # PhiGent Web 控制台
MINIO_API_PORT=9000                 # MinIO S3 API
MINIO_CONSOLE_PORT=9001             # MinIO Web 控制台

# ---- Ollama 模型 ----------------------------------------------------------
EMBED_MODEL=nomic-embed-text        # embedding 模型名
EMBED_DIMENSION=768                 # 向量维度（须与模型一致）

# ---- Ollama 资源（GPU 部署；纯 CPU 删掉 compose 的 ollama deploy 段）------
OLLAMA_GPU_COUNT=all                # GPU 卡数：all / 具体数字
OLLAMA_NUM_GPUS=4                   # 实际可用 GPU 数
OLLAMA_NUM_PARALLEL=8               # 单模型并行请求数
OLLAMA_PARALLEL_REQUESTS=32         # 调度并行数
OLLAMA_MAX_BATCH_SIZE=1024          # 最大 batch 大小
OLLAMA_CPU_THREADS=16               # CPU 线程数

# ---- git-index 索引行为 ---------------------------------------------------
GIT_INDEX_DAILY_HOUR=3              # 每日定时拉取小时 (0-23)，null 禁用
GIT_INDEX_RELEASE_AFTER=false       # false=索引后保持 LOADED（推荐）
GIT_INDEX_CONCURRENCY=6             # 并行索引仓库数（瓶颈在 Ollama embedding）
GIT_SSL_NO_VERIFY=false             # 内网 GitLab 自签证书时改为 true
GIT_INDEX_UID=1015                  # 克隆产物属主 uid
GIT_INDEX_GID=1015                  # 克隆产物属主 gid

# ---- PhiGent Web 控制台 ---------------------------------------------------
MILVUS_URL=standalone:19530         # 同机部署用容器名；外部 Milvus 改为 IP:19530

# ---- 容器资源上限 ---------------------------------------------------------
# 共享服务器场景：失控时 OOM 重启不拖垮整机。独占机器可整体上调。
MILVUS_MEM_LIMIT=64g
MILVUS_CPU_LIMIT=24
OLLAMA_MEM_LIMIT=32g
OLLAMA_CPU_LIMIT=16
GIT_INDEX_MEM_LIMIT=16g
GIT_INDEX_CPU_LIMIT=12
MINIO_MEM_LIMIT=8g
MINIO_CPU_LIMIT=4
ETCD_MEM_LIMIT=4g
ETCD_CPU_LIMIT=2
PHIGENT_MEM_LIMIT=2g
PHIGENT_CPU_LIMIT=2
