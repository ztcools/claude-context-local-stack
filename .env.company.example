# =============================================================================
# 公司服务器部署配置（仅 Seeway 内部使用）
# 用法: cp .env.company.example .env.company  编辑后 source 即可
# 此文件含服务器地址/路径等信息，已被 .gitignore 排除，请勿提交。
# =============================================================================

# ---- push-to-server.sh 目标机 -------------------------------------------
export REMOTE_USER=       # SSH 用户名
export REMOTE_HOST=       # 服务器 IP
export REMOTE_DIR=        # docker-compose 栈目录

# ---- 使用方式 ------------------------------------------------------------
# source .env.company && ./push-to-server.sh
